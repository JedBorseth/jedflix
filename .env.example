# Public site domain (must resolve to this server for Caddy SSL)
DOMAIN=borseth.ddns.net
ACME_EMAIL=you@example.com

# Convex (from .env.local after `convex dev` / `convex deploy`)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional: used by GitHub Actions or manual deploy scripts on the server
# CONVEX_DEPLOY_KEY=

# Go backend (frontend uses same-origin /backend via Caddy)
VITE_BACKEND_URL=/backend
# Legacy alias (still accepted):
# VITE_STREAM_API_URL=/backend

ABB_BASE_URL=https://audiobookbay.lu
ABB_USERNAME=
ABB_PASSWORD=

# Go backend secrets (server-side only — never VITE_ / EXPO_PUBLIC_)
# Prefer TMDB_API_KEY. VITE_TMDB_API_KEY is accepted temporarily as a fallback
# for servers that still only have the old frontend env var.
TMDB_API_KEY=
# VITE_TMDB_API_KEY=
CORS_ORIGINS=https://borseth.ddns.net
RD_BLOCKED_FILENAME_REGEX=web-dl|webrip|bdrip|hdrip|dvdrip|BluRay\.x264|HDTV\.x264|HDTV\.XviD|WEB\.x264|WEB\.h264

# Music catalog (MusicBrainz) — no API key. Last.fm optional for shelves/images.
MUSIC_CATALOG_PATH=/data/music-catalog.json
MUSIC_CATALOG_CACHE_TTL=6h
# Last.fm API key for related artists/tracks, Infinite Queue, and catalog enrichment
LASTFM_API_KEY=
# Spotify credentials are only needed for party mode / playlist sync on Convex
# (`npx convex env set SPOTIFY_CLIENT_ID ...`) plus redirect:
# https://<deployment>.convex.site/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional Netscape cookies for yt-dlp if YouTube bot-checks the server
YTDLP_COOKIES_FILE=
