# Public site domain (must resolve to this server for Caddy SSL)
DOMAIN=borseth.ddns.net
ACME_EMAIL=you@example.com

# Convex (from .env.local after `convex dev` / `convex deploy`)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional: used by GitHub Actions or manual deploy scripts on the server
# CONVEX_DEPLOY_KEY=

# TMDB
VITE_TMDB_API_KEY=

# Stream API (frontend uses same-origin /stream-api via Caddy)
VITE_STREAM_API_URL=/stream-api
VITE_STREAM_API_KEY=

ABB_BASE_URL=https://audiobookbay.lu
ABB_USERNAME=
ABB_PASSWORD=

# Go stream-server
REALDEBRID_TOKEN=
STREAM_SERVER_API_KEY=
CORS_ORIGINS=https://borseth.ddns.net
RD_BLOCKED_FILENAME_REGEX=web-dl|webrip|bdrip|hdrip|dvdrip|BluRay\.x264|HDTV\.x264|HDTV\.XviD|WEB\.x264|WEB\.h264

# Spotify (music catalog via stream-server client credentials)
#
# Party mode also needs these same values set in the Convex deployment
# (`npx convex env set SPOTIFY_CLIENT_ID ...`) so it can run the user
# authorization-code flow, plus this redirect URI registered in the Spotify
# dashboard: https://<deployment>.convex.site/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Last.fm API key for related artists/tracks and Infinite Queue (stream-server only)
LASTFM_API_KEY=
# Optional Netscape cookies for yt-dlp if YouTube bot-checks the server
YTDLP_COOKIES_FILE=
