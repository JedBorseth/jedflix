# Keep Alpine (musl) so the existing MusicBrainz data directory stays
# collation-compatible. Switching to a Debian pgvector image would risk
# index/locale breakage on the replica.
FROM postgres:16-alpine

# postgres:16-alpine currently expects clang-21 / llvm-lto for JIT bitcode.
RUN set -eux; \
	apk add --no-cache --virtual .build-deps git build-base clang21 llvm21 llvm21-dev; \
	git clone --branch v0.8.0 --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector; \
	make -C /tmp/pgvector OPTFLAGS=""; \
	make -C /tmp/pgvector install; \
	apk del .build-deps; \
	rm -rf /tmp/pgvector
