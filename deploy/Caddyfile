{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

    # Shooter crash inbox: HTTPS write-only; reports stay outside the web root.
    handle /shooter/crashes {
        request_body {
            max_size 2097664
        }
        reverse_proxy 172.19.0.1:27011 {
            request_buffers 2097664
            transport http {
                dial_timeout 3s
                response_header_timeout 15s
                read_timeout 15s
                write_timeout 15s
            }
        }
    }


	# Canonical backend prefix.
	handle /backend/* {
		uri strip_prefix /backend
		reverse_proxy backend:8080 {
			# Real Debrid resolve can poll for several minutes on uncached torrents.
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	# JedFlix TV API (JedBorseth/jedflix-tv, server/). Runs from its own
	# compose project on this host and joins the jedflix_default network.
	handle /tv-api/* {
		uri strip_prefix /tv-api
		reverse_proxy jedflix-tv-api:8080
	}

	# Legacy /stream-api path (covers + older clients).
	handle /stream-api/* {
		uri strip_prefix /stream-api
		reverse_proxy backend:8080 {
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
