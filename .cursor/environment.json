{
  "name": "JedFlix",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "convex",
      "command": "bash .cursor/dev-convex.sh"
    },
    {
      "name": "backend",
      "command": "cd \"$(git rev-parse --show-toplevel)/apps/backend\" && PATH=\"/usr/local/go/bin:$PATH\" go run ./cmd/backend"
    },
    {
      "name": "web",
      "command": "cd \"$(git rev-parse --show-toplevel)\" && PATH=\"$HOME/.bun/bin:$PATH\" bunx turbo run dev --filter=@jedflix/web -- --host 0.0.0.0"
    }
  ],
  "ports": [5173, 8080, 3210, 3211]
}
