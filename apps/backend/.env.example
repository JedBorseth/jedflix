TORRENTIO_URL=https://torrentio.strem.fun
MAX_VIDEO_SIZE_GB=50
MIN_SEEDERS=3
PREFER_INSTANT=true
RD_BLOCKED_FILENAME_REGEX=web-dl|webrip|bdrip|hdrip|dvdrip|BluRay\.x264|HDTV\.x264|HDTV\.XviD|WEB\.x264|WEB\.h264
CORS_ORIGINS=http://localhost:5173
ADDR=:8080
LETTERBOXD_BASE_URL=https://letterboxd.com
LETTERBOXD_CACHE_TTL=1h
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_CACHE_TTL=12h
OPEN_LIBRARY_COVER_PUBLIC_BASE=/backend/api/v1/openlibrary/covers
# Server-side only — proxied to clients via /api/v1/tmdb/*
TMDB_API_KEY=
# Music catalog uses MusicBrainz (+ Cover Art Archive). No API key required.
# Optional Last.fm key improves home shelves, artist images, and top tracks.
MUSICBRAINZ_API_BASE_URL=https://musicbrainz.org/ws/2
COVER_ART_ARCHIVE_BASE_URL=https://coverartarchive.org
MUSIC_CATALOG_CACHE_TTL=6h
# Persisted music-home catalog (survives container restarts). Empty disables.
MUSIC_CATALOG_PATH=/data/music-catalog.json
# Legacy path still accepted as a fallback for MUSIC_CATALOG_PATH:
# SPOTIFY_CATALOG_PATH=/data/spotify-catalog.json
# Spotify credentials are only needed for party mode / playlist sync (Convex OAuth).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Last.fm API key (recommendations / similar artists & tracks + catalog enrichment).
LASTFM_API_KEY=
LASTFM_CACHE_TTL=6h
# Optional Netscape cookie file for yt-dlp when YouTube bot-checks the server IP.
YTDLP_COOKIES_FILE=
ABB_BASE_URL=https://audiobookbay.lu
ABB_USERNAME=
ABB_PASSWORD=
MAX_CONCURRENT_RESOLVES=6
MAX_CONCURRENT_YOUTUBE=3
